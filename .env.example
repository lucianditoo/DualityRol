# ==============================================================================
# DUALITY ROL — CONFIGURACIÓN DE VARIABLES DE ENTORNO (EJEMPLO)
# Copiar como .env en desarrollo local y en el servidor Linux.
# NUNCA subir claves de producción a repositorios públicos o privados.
# ==============================================================================

# ENTORNO
NODE_ENV=development
PORT_STORE=3000
PORT_ADMIN=3001

# BASE DE DATOS (PostgreSQL)
# Conexión local a través del servicio Docker o localhost:
DB_USER=duality_user
DB_PASSWORD=duality_secure_password_dev_only
DB_NAME=duality_rol
DB_PORT=5432
DATABASE_URL=postgresql://duality_user:duality_secure_password_dev_only@localhost:5432/duality_rol?schema=public

# URLS BASE DE APLICACIONES
NEXT_PUBLIC_STORE_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001

# MERCADO PAGO (SANDBOX / PRUEBAS)
# Obtener credenciales de prueba en https://www.mercadopago.com.ar/developers
MP_PUBLIC_KEY=TEST-00000000-0000-0000-0000-000000000000
MP_ACCESS_TOKEN=TEST-0000000000000000-000000-00000000000000000000000000000000-000000000
MP_WEBHOOK_SECRET=test_webhook_secret_key

# ALMACENAMIENTO DE MEDIOS (Imágenes de productos)
# Ruta del volumen montado donde se guardan físicamente las imágenes
MEDIA_STORAGE_PATH=./uploads
# Límite máximo de subida en bytes (5 MB = 5242880)
MAX_FILE_SIZE_BYTES=5242880

# SEGURIDAD Y AUTENTICACIÓN DEL ADMINISTRADOR
# Secreto aleatorio de 32+ caracteres para firmar sesiones / JWT
ADMIN_AUTH_SECRET=cambiar_por_un_secreto_aleatorio_muy_largo_y_seguro_en_produccion
# Tiempo de expiración de sesión (ej: 8 horas)
ADMIN_SESSION_MAX_AGE_SECONDS=28800

# INFORMACIÓN DE RETIRO (Punto de entrega en primera etapa)
PICKUP_LOCATION_TITLE="Punto de Retiro Duality Rol"
PICKUP_LOCATION_DESCRIPTION="Coordinación por WhatsApp una vez confirmado el pedido."
PICKUP_CONTACT_WHATSAPP="+5491100000000"
